{
  "name": "packguard",
  "version": "0.1.0",
  "private": true,
  "description": "PackGuard — inspect an npm package for security risks before installing it.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
