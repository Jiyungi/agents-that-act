{
  "inputs": [
    {
      "type": "promptString",
      "id": "opsera-api-token",
      "description": "Opsera API token",
      "password": true
    }
  ],
  "servers": {
    "opsera": {
      "type": "http",
      "url": "https://agent.opsera.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${input:opsera-api-token}"
      }
    }
  }
}
