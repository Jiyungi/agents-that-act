# ---------------------------------------------------------------------------
# PackGuard Frontend_UI (web/) configuration — copy to `.env` (or `.env.local`).
# All client-exposed vars MUST be prefixed with VITE_.
# ---------------------------------------------------------------------------

# Backend mode:
#   unset / "true"  → in-browser mock (fixtures) — good for design/demo
#   "false"         → real backend: same-origin /api/* + local agent
# Production builds default to the real backend; dev defaults to mock.
VITE_USE_MOCK=false

# Local loopback agent base URL (filesystem-bound steps). Default shown.
VITE_AGENT_URL=http://127.0.0.1:3939

# Dev-only: where Vite proxies /api/* (the Vercel dev server). Default shown.
VITE_API_PROXY=http://127.0.0.1:3000
