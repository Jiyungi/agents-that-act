# ---------------------------------------------------------------------------
# PackGuard configuration — copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real credentials.
#
# On Vercel, set these as Project Environment Variables instead of a .env file.
# ---------------------------------------------------------------------------

# --- Tigris object storage (S3-compatible) ----------------------------------
# Get these from https://console.storage.dev . AWS_* names are used on purpose
# so the S3 SDK picks them up automatically.
AWS_ACCESS_KEY_ID=your-tigris-access-key-id
AWS_SECRET_ACCESS_KEY=your-tigris-secret-access-key
# Tigris S3 endpoint. The config loader reads TIGRIS_ENDPOINT first and falls
# back to AWS_ENDPOINT_URL_S3 (which the AWS SDK also reads natively).
TIGRIS_ENDPOINT=https://t3.storage.dev
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
TIGRIS_BUCKET=packguard
# Optional: serve reports from a public Tigris domain instead of the /api/report
# proxy. Leave unset to use the same-origin proxy (works with private buckets).
# PUBLIC_REPORT_URL_BASE=https://packguard.t3.tigrisfiles.io

# --- Daytona (Person C feasibility experiment) ------------------------------
DAYTONA_API_KEY=your-daytona-api-key
DAYTONA_API_URL=https://app.daytona.io/api

# --- Verdict threshold ------------------------------------------------------
# Risk score threshold T (0..100). riskScore < T => SAFE, riskScore >= T => RISKY.
RISK_THRESHOLD=50

# --- Local fetcher agent (runs on the operator machine, NOT on Vercel) ------
# Loopback port for the local agent (bound to 127.0.0.1 only).
LOCAL_AGENT_PORT=3939
# Isolated extraction root for fetched, untrusted package source. Never executed.
SCAN_TARGET_DIR=./scan-target
# Base URL of the npm registry used for resolution and tarball download.
NPM_REGISTRY_BASE=https://registry.npmjs.org
# Optional: override the editor launch command (defaults to auto-detecting
# VS Code / code-insiders / kiro). e.g. EDITOR_COMMAND=code
# EDITOR_COMMAND=code
