# Tigris (S3-compatible) credentials - get these from console.storage.dev
# These use AWS variable names on purpose so the S3 SDK picks them up automatically.
AWS_ACCESS_KEY_ID=your-tigris-access-key-id
AWS_SECRET_ACCESS_KEY=your-tigris-secret-access-key
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
TIGRIS_BUCKET=packguard
# Tigris endpoint (mirrors AWS_ENDPOINT_URL_S3 above; either is accepted)
TIGRIS_ENDPOINT=https://t3.storage.dev

# Verdict threshold T (integer 0-100). riskScore < T => SAFE, >= T => RISKY.
RISK_THRESHOLD=50

# Local loopback agent (Person A)
LOCAL_AGENT_PORT=3939
SCAN_TARGET_DIR=./scan-target

# npm registry base URL (Person A)
NPM_REGISTRY_BASE=https://registry.npmjs.org
